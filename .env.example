# Copy to .env and fill in. Never commit .env.

# Database (compose maps Postgres to host port 55432)
ATRIUM_DATABASE_URL=postgresql+psycopg://atrium_app:atrium_app@localhost:55432/atrium
ATRIUM_OWNER_DATABASE_URL=postgresql+psycopg://atrium_owner:atrium_owner@localhost:55432/atrium

# Pins "today" for the fictional reference dataset. Leave empty in a real deployment.
ATRIUM_TODAY=2026-10-01

# Signing key for the development identity provider (dev only).
ATRIUM_DEV_JWT_SECRET=change-me-dev-only

# Optional OIDC (production). When set, tokens from this issuer are accepted.
ATRIUM_OIDC_ISSUER=
ATRIUM_OIDC_AUDIENCE=

# LLM provider: "fake" (deterministic, default) or "openai" (any OpenAI-compatible API)
ATRIUM_LLM_PROVIDER=fake
LLM_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
LLM_MAX_TOKENS=900

# Embeddings: "hash" (deterministic, tests) or "fastembed" (local CPU model)
ATRIUM_EMBEDDINGS=fastembed
